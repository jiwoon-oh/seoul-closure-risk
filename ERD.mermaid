erDiagram
    area_boundary {
        int area_code PK "1,650 areas · master"
        string area_type_name "neighborhood 1090 · traditional 305 · developed 249 · tourist 6"
        string district_name "25 districts"
        int admin_dong_code
        float x_coord "EPSG:5181 metres"
        float y_coord "EPSG:5181 metres"
        float area_size "square metres · log transform required"
    }

    store_by_area {
        int quarter_code PK "20231~20261, 13 quarters"
        int area_code FK
        int service_code PK "10 food categories out of 100"
        string service_name "treatment variable"
        int store_count "matching covariate 1 · schema harmonization needed"
        int franchise_store_count
        int opening_count "label source"
        int closure_count "label source"
    }

    foot_traffic_by_area {
        int quarter_code PK "20211~20261"
        int area_code FK
        bigint foot_traffic_total "matching covariate 2 · core of H2"
        bigint foot_traffic_by_time "not used"
        bigint foot_traffic_by_weekday "not used"
    }

    facility_by_area {
        int quarter_code PK "20211~20261"
        int area_code FK "1,578 areas · about 2 percent missing"
        int attracting_facility_count "matching covariate 4"
        int subway_station_count "location helper"
        int bus_stop_count "not used"
    }

    sales_by_area {
        int quarter_code PK "20231~20261"
        int area_code FK
        int service_code PK "62 categories · beware of missing values"
        bigint monthly_sales "supporting · excluded from matching"
        bigint monthly_sales_count "supporting"
    }

    analysis_panel_neighborhood_food {
        int quarter_code PK
        int area_code PK
        int service_code PK
        int treated "high-risk category 1, others 0"
        int y "net decline in t plus 1"
        float log_store_count "covariate 1"
        float log_foot_traffic "covariate 2"
        float log_area_size "covariate 3"
        float log_attracting_facilities "covariate 4"
        float propensity_score "computed in STEP 6"
    }

    area_boundary ||--o{ store_by_area : "area_code"
    area_boundary ||--o{ foot_traffic_by_area : "area_code"
    area_boundary ||--o{ facility_by_area : "area_code"
    area_boundary ||--o{ sales_by_area : "area_code"

    store_by_area ||--|| analysis_panel_neighborhood_food : "base table · 10 food categories, neighborhood areas, at least 5 stores"
    foot_traffic_by_area ||--|| analysis_panel_neighborhood_food : "join on quarter plus area"
    facility_by_area |o--|| analysis_panel_neighborhood_food : "left join on quarter plus area"
    sales_by_area |o--|| analysis_panel_neighborhood_food : "left join on quarter plus area plus service"
